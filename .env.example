# EcoTap — environment variables
# Copy to .env.local and fill in:  cp .env.example .env.local
# .env.local is gitignored. Never commit real credentials.

# ── Supabase ──────────────────────────────────────────────────────────────
# Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Bypasses Row Level Security — never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# ── Site ──────────────────────────────────────────────────────────────────
# Used to build absolute URLs (vCard links, canonical metadata, sitemap).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Cloudflare R2 (image uploads) ─────────────────────────────────────────
# R2 → your bucket → Settings. Endpoint is the S3 API URL, not the CDN URL.
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# Public CDN base URL for the bucket, no trailing slash.
# e.g. https://cdn.ecotap.rw  — must match the remotePatterns host
# configured in next.config.ts.
R2_PUBLIC_URL=

# NOTE: uploads fail (in profile photos, company logos, card designs and
# payment screenshots) if the R2_* block is left empty. The rest of the app
# runs fine without them.
